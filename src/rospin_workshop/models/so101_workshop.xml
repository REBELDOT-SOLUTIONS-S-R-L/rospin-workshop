<!--
  MuJoCo workshop scene using the official LeRobot SO-101 URDF and STL meshes:
    assets/robots/so101/so101_new_calib.urdf
    assets/robots/so101/assets/*.stl

  Joint frames, inertials, visual origins, materials, and limits are transcribed
  from that URDF. The scene geometry and lights come from assets/scenes/scene.usd.
  The wrist camera pose comes from the previously supplied camera USD layer.

  SO101_MESH_DIR is replaced with an absolute path by SO101WorkshopEnv before
  MuJoCo compiles this model, allowing the same XML to run from source or Docker.
-->
<mujoco model="so101_workshop">
  <!-- URDF rpy is an extrinsic X-Y-Z rotation. MuJoCo denotes extrinsic
       sequences with uppercase axis letters; lowercase xyz is intrinsic and
       visibly scatters the SO-101 link meshes. -->
  <compiler angle="radian" eulerseq="XYZ" autolimits="true"
            meshdir="SO101_MESH_DIR"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81">
    <flag multiccd="enable"/>
  </option>

  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="512" offsamples="0"/>
    <headlight ambient="0.25 0.25 0.25" diffuse="0.65 0.65 0.65"/>
  </visual>

  <default>
    <joint damping="0.35" armature="0.015" frictionloss="0.04"/>
    <geom condim="4" friction="1.0 0.01 0.001" solref="0.004 1"/>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="collision">
      <!-- Lightweight convex proxies provide stable table contact; STL geometry
           is used for every rendered robot component. -->
      <geom contype="2" conaffinity="1" group="4" rgba="0 0 0 0"/>
    </default>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.82 0.88 0.96" rgb2="0.18 0.24 0.34" width="512" height="3072"/>
    <texture name="ground_grid" type="2d" builtin="checker"
             rgb1="0.19 0.22 0.25" rgb2="0.11 0.13 0.15" width="512" height="512"/>
    <material name="ground" texture="ground_grid" texrepeat="8 8" reflectance="0.08"/>
    <material name="table" rgba="0.32 0.34 0.37 1" reflectance="0.12"/>
    <material name="printed_yellow" rgba="1.0 0.82 0.12 1" reflectance="0.16"/>
    <material name="servo_black" rgba="0.1 0.1 0.1 1" reflectance="0.08"/>

    <mesh name="base_motor_holder" file="base_motor_holder_so101_v1.stl"/>
    <mesh name="base_shell" file="base_so101_v2.stl"/>
    <mesh name="motor_holder_base" file="motor_holder_so101_base_v1.stl"/>
    <mesh name="motor_holder_wrist" file="motor_holder_so101_wrist_v1.stl"/>
    <mesh name="moving_jaw" file="moving_jaw_so101_v1.stl"/>
    <mesh name="rotation_pitch" file="rotation_pitch_so101_v1.stl"/>
    <mesh name="servo_no_horn" file="sts3215_03a_no_horn_v1.stl"/>
    <mesh name="servo" file="sts3215_03a_v1.stl"/>
    <mesh name="under_arm" file="under_arm_so101_v1.stl"/>
    <mesh name="upper_arm" file="upper_arm_so101_v1.stl"/>
    <mesh name="mounting_plate" file="waveshare_mounting_plate_so101_v2.stl"/>
    <mesh name="wrist_roll_follower" file="wrist_roll_follower_so101_v1.stl"/>
    <mesh name="wrist_roll_pitch" file="wrist_roll_pitch_so101_v2.stl"/>
  </asset>

  <worldbody>
    <!-- scene.usd: ground spans 50 m and table bbox is 0.74 x 0.74 x 0.75 m -->
    <geom name="ground_plane" type="plane" size="25 25 0.1" material="ground"
          contype="1" conaffinity="2"/>
    <geom name="table" type="box" pos="0 0 0.3794030483"
          size="0.37 0.37 0.375" material="table" contype="1" conaffinity="2"/>

    <light name="key_light" pos="0.08527694 0.07633769 5.05754737"
           dir="0 0 -1" diffuse="0.85 0.85 0.85" castshadow="false"/>
    <light name="fill_light" pos="-2.49434230 0 3.66311920"
           dir="0.707107 0 -0.707107" diffuse="0.55 0.55 0.55"
           castshadow="false"/>

    <!-- Third-person camera centered directly behind the -Y-facing arm,
         elevated and pitched down toward its tabletop workspace. -->
    <camera name="perspective" pos="0 0.72 1.22"
            xyaxes="-1 0 0 0 -0.43796942 0.89898987"
            fovy="48"/>

    <!-- Mount the URDF base toward the back edge and face it 90 degrees
         clockwise, into the usable -Y half of the table. Keeping this scene
         transform outside base_link preserves every source-URDF transform. -->
    <body name="robot_mount" pos="0 0.23 0.7545030483"
          euler="0 0 -1.5707963267948966">
    <body name="base_link">
      <geom class="visual" mesh="base_motor_holder" material="printed_yellow"
            pos="-0.00636471 -0.0000994414 -0.0024"
            euler="1.5708 -0.00000000000000167685 1.5708"/>
      <geom class="visual" mesh="base_shell" material="printed_yellow"
            pos="-0.00636471 -0.00000000897657 -0.0024"
            euler="1.5708 0 1.5708"/>
      <geom class="visual" mesh="servo" material="servo_black"
            pos="0.0263353 -0.00000000897657 0.0437"/>
      <geom class="visual" mesh="mounting_plate" material="printed_yellow"
            pos="-0.0309827 -0.000199441 0.0474"
            euler="1.5708 -0.0000000000000135493 1.5708"/>
      <geom class="collision" type="cylinder" pos="0 0 0.026" size="0.058 0.026"/>

      <body name="shoulder_link" pos="0.0388353 -0.00000000897657 0.0624"
            euler="3.14159 0 -3.14159">
        <joint name="shoulder_pan" type="hinge" axis="0 0 1"
               range="-1.91986 1.91986"/>
        <inertial pos="-0.0307604 -0.0000166727 -0.0252713" mass="0.100006"
                  fullinertia="0.000083759 0.0000810403 0.0000239783 0.0000000755525 -0.00000116342 0.000000154663"/>
        <geom class="visual" mesh="servo" material="servo_black"
              pos="-0.0303992 0.000422241 -0.0417" euler="1.5708 1.5708 0"/>
        <geom class="visual" mesh="motor_holder_base" material="printed_yellow"
              pos="-0.0675992 -0.000177759 0.0158499" euler="1.5708 -1.5708 0"/>
        <geom class="visual" mesh="rotation_pitch" material="printed_yellow"
              pos="0.0122008 0.0000222413 0.0464" euler="-1.5708 0 0"/>
        <geom class="collision" type="cylinder" pos="0 0 -0.025" size="0.041 0.050"/>

        <body name="upper_arm_link" pos="-0.0303992 -0.0182778 -0.0542"
              euler="-1.5708 -1.5708 0">
          <joint name="shoulder_lift" type="hinge" axis="0 0 1"
                 range="-1.74533 1.74533"/>
          <inertial pos="-0.0898471 -0.00838224 0.0184089" mass="0.103"
                    fullinertia="0.0000408002 0.000147318 0.000142487 -0.0000197819 -0.0000000403016 0.00000000897326"/>
          <geom class="visual" mesh="servo" material="servo_black"
                pos="-0.11257 -0.0155 0.0187" euler="-3.14159 0 -1.5708"/>
          <geom class="visual" mesh="upper_arm" material="printed_yellow"
                pos="-0.065085 0.012 0.0182" euler="3.14159 0 0"/>
          <geom class="collision" type="capsule"
                fromto="0 0 0 -0.11257 -0.028 0" size="0.026"/>

          <body name="lower_arm_link" pos="-0.11257 -0.028 0"
                euler="0 0 1.5708">
            <joint name="elbow_flex" type="hinge" axis="0 0 1"
                   range="-1.69 1.69"/>
            <inertial pos="-0.0980701 0.00324376 0.0182831" mass="0.104"
                      fullinertia="0.0000287438 0.000159844 0.00014529 0.00000741152 0.00000126409 -0.0000000490188"/>
            <geom class="visual" mesh="under_arm" material="printed_yellow"
                  pos="-0.0648499 -0.032 0.0182" euler="3.14159 0 0"/>
            <geom class="visual" mesh="motor_holder_wrist" material="printed_yellow"
                  pos="-0.0648499 -0.032 0.018" euler="-3.14159 0 0"/>
            <geom class="visual" mesh="servo" material="servo_black"
                  pos="-0.1224 0.0052 0.0187" euler="-3.14159 0 -3.14159"/>
            <geom class="collision" type="capsule"
                  fromto="0 0 0 -0.1349 0.0052 0" size="0.024"/>

            <body name="wrist_link" pos="-0.1349 0.0052 0"
                  euler="0 0 -1.5708">
              <joint name="wrist_flex" type="hinge" axis="0 0 1"
                     range="-1.65806 1.65806"/>
              <inertial pos="-0.000103312 -0.0386143 0.0281156" mass="0.079"
                        fullinertia="0.0000368263 0.000025391 0.000021 0.000000017893 -0.0000000528128 0.0000036412"/>
              <geom class="visual" mesh="servo_no_horn" material="servo_black"
                    pos="0 -0.0424 0.0306" euler="1.5708 1.5708 0"/>
              <geom class="visual" mesh="wrist_roll_pitch" material="printed_yellow"
                    pos="0 -0.028 0.0181" euler="-1.5708 -1.5708 0"/>
              <geom class="collision" type="capsule"
                    fromto="0 0 0 0 -0.0611 0.0181" size="0.023"/>

              <body name="gripper_link" pos="0 -0.0611 0.0181"
                    euler="1.5708 0.0486795 3.14159">
                <joint name="wrist_roll" type="hinge" axis="0 0 1"
                       range="-2.74385 2.84121"/>
                <inertial pos="0.000213627 0.000245138 -0.025187" mass="0.087"
                          fullinertia="0.0000275087 0.0000433657 0.0000345059 -0.000000335241 -0.0000057352 -0.0000000517847"/>
                <geom class="visual" mesh="servo" material="servo_black"
                      pos="0.0077 0.0001 -0.0234" euler="-1.5708 0 0"/>
                <geom class="visual" mesh="wrist_roll_follower" material="printed_yellow"
                      pos="0 -0.000218214 0.000949706" euler="-3.14159 0 0"/>
                <geom class="collision" type="capsule"
                      fromto="0 0 0 -0.0079 -0.000218121 -0.0981274" size="0.024"/>

                <!-- Calibrated against the 1280x720 /dev/video2 feed: the
                     jaw midpoint matches its slightly left-of-center position. -->
                <camera name="wrist"
                        pos="0.0325 0.1 -0.0002876164"
                        quat="0.9517752157 -0.3066331913 -0.0098696427 -0.0016170651"
                        fovy="62"/>

                <body name="gripper_frame_link"
                      pos="-0.0079 -0.000218121 -0.0981274"
                      euler="0 3.14159 0">
                  <site name="eef_site" type="sphere" size="0.005"
                        rgba="1 0.2 0.1 0.75" group="3"/>
                </body>

                <body name="moving_jaw_so101_v1_link"
                      pos="0.0202 0.0188 -0.0234"
                      euler="1.5708 -0.0000000524284 0">
                  <joint name="gripper" type="hinge" axis="0 0 1"
                         range="-0.174533 1.74533"/>
                  <inertial pos="-0.00157495 -0.0300244 0.0192755" mass="0.012"
                            fullinertia="0.00000661427 0.00000189032 0.00000528738 -0.000000319807 -0.00000000590717 -0.000000109945"/>
                  <geom class="visual" mesh="moving_jaw" material="printed_yellow"
                        pos="0 0 0.0189"/>
                  <geom class="collision" type="box" pos="0 -0.038 0.0189"
                        size="0.012 0.045 0.012"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_pan_ctrl" joint="shoulder_pan" kp="140" kv="8"
              ctrlrange="-1.91986 1.91986" forcerange="-20 20"/>
    <position name="shoulder_lift_ctrl" joint="shoulder_lift" kp="140" kv="8"
              ctrlrange="-1.74533 1.74533" forcerange="-20 20"/>
    <position name="elbow_flex_ctrl" joint="elbow_flex" kp="120" kv="7"
              ctrlrange="-1.69 1.69" forcerange="-18 18"/>
    <position name="wrist_flex_ctrl" joint="wrist_flex" kp="100" kv="6"
              ctrlrange="-1.65806 1.65806" forcerange="-14 14"/>
    <position name="wrist_roll_ctrl" joint="wrist_roll" kp="70" kv="4"
              ctrlrange="-2.74385 2.84121" forcerange="-10 10"/>
    <position name="gripper_ctrl" joint="gripper" kp="35" kv="3"
              ctrlrange="-0.174533 1.74533" forcerange="-6 6"/>
  </actuator>

  <keyframe>
    <!-- A nonsingular tabletop pose with the gripper and wrist camera aimed
         into the usable workspace. -->
    <key name="home" qpos="0 -0.7651 0.7632 0.6437 -2.2143 0.65"
         ctrl="0 -0.7651 0.7632 0.6437 -2.2143 0.65"/>
  </keyframe>
</mujoco>
